# Lightweight multimodal RAG development configuration
# Copy this file to .env and replace placeholder values. Never commit .env.

# Local directories
WORKING_DIR=./rag_storage_app
OUTPUT_DIR=./output
INPUT_DIR=./data/uploads

# Document parsing
PARSER=mineru
PARSE_METHOD=auto
DISPLAY_CONTENT_STATS=true

# MVP modalities: text is always enabled
ENABLE_IMAGE_PROCESSING=true
ENABLE_TABLE_PROCESSING=true
ENABLE_EQUATION_PROCESSING=true
ENABLE_AUDIO_PROCESSING=false
ENABLE_VIDEO_PROCESSING=false

# Keep ingestion conservative for a single-process demo
MAX_CONCURRENT_FILES=1
MAX_PARALLEL_INSERT=1
SUPPORTED_FILE_EXTENSIONS=.pdf,.md,.png,.jpg,.jpeg
RECURSIVE_FOLDER_PROCESSING=false

# Context used when describing images, tables, and equations
CONTEXT_WINDOW=1
CONTEXT_MODE=page
MAX_CONTEXT_TOKENS=2000
INCLUDE_HEADERS=true
INCLUDE_CAPTIONS=true
CONTEXT_FILTER_CONTENT_TYPES=text
CONTENT_FORMAT=minerU

# DeepSeek V4.1 Flash (OpenAI-compatible text and vision model)
LLM_BINDING=openai
LLM_MODEL=deepseek-flash
VISION_MODEL=deepseek-flash
LLM_BINDING_HOST=https://api.deepseek.com
LLM_BINDING_API_KEY=replace-with-your-api-key

# Local Ollama embedding model (run: ollama pull bge-m3)
EMBEDDING_BINDING=openai
EMBEDDING_MODEL=bge-m3
EMBEDDING_DIM=1024
EMBEDDING_BINDING_HOST=http://localhost:11434/v1
EMBEDDING_BINDING_API_KEY=ollama

# Model-call limits
ENABLE_LLM_CACHE=true
ENABLE_LLM_CACHE_FOR_EXTRACT=true
MAX_ASYNC=4
TIMEOUT=240
TEMPERATURE=0

# Application layer (implemented in a later phase)
APP_HOST=127.0.0.1
APP_PORT=8000
MAX_UPLOAD_MB=20

# Logging
LOG_LEVEL=INFO
VERBOSE=false
